{
  "name": "orcahub-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de orçamentos para qualquer tipo de serviço, com cadastro de clientes e endereço automático via ViaCEP.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:setup": "tsx src/db/setup.ts",
    "typecheck": "tsc --noEmit",
    "predev": "npm run -s db:setup",
    "prestart": "npm run -s db:setup"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
